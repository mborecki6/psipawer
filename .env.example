NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Auth mail is sent by Supabase Auth, not the business email worker below.
# Configure SMTP, Site URL and invite/recovery templates in Supabase separately.
# Hosted Auth also requires production runtime and this exact trusted app origin.
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_HOSTED_ENABLED=false
AUTH_EMAIL_APP_ORIGIN=
# Separate sending switch; requires the Auth configuration and a server key.
CLIENT_INVITATIONS_ENABLED=false

# Tpay: blank mode is off. simulator is local-only; sandbox and live are separate.
# TPAY_ENABLED starts new checkouts only. Keep processing configuration when pausing checkout.
TPAY_ENABLED=false
TPAY_MODE=
TPAY_HOSTED_ENABLED=false
TPAY_APP_ORIGIN=
TPAY_LIVE_ENABLED=false
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_MERCHANT_ID=
# An explicit empty code is valid only if the merchant configured no code.
TPAY_SECURITY_CODE=
TPAY_RECONCILIATION_ENABLED=false
PAYMENTS_WORKER_SECRET=

# Independent business SMTP: schedules, reminders and confirmed payments.
# Also requires business_email_settings.enabled in DB; both switches default off.
BUSINESS_EMAIL_ENABLED=false
BUSINESS_EMAIL_DEPLOYMENT=
BUSINESS_EMAIL_HOSTED_ENABLED=false
BUSINESS_EMAIL_SMTP_HOST=
BUSINESS_EMAIL_SMTP_PORT=
# false uses STARTTLS for hosted SMTP; true means implicit TLS (usually port 465).
BUSINESS_EMAIL_SMTP_SECURE=false
BUSINESS_EMAIL_SMTP_USER=
BUSINESS_EMAIL_SMTP_PASSWORD=
# One mailbox only, without a display name or address list.
BUSINESS_EMAIL_SMTP_FROM=
# Optional: leave this variable absent when no Reply-To is needed.
# BUSINESS_EMAIL_REPLY_TO=reply@example.com
BUSINESS_EMAIL_SECRET=

# Each worker secret must be separate: 43..128 base64url characters from a CSPRNG.
# POST /api/internal/payments -> PAYMENTS_WORKER_SECRET
# POST /api/internal/email -> BUSINESS_EMAIL_SECRET
# POST /api/internal/maintenance -> MAINTENANCE_SECRET (reminders/inbox/push)
# Keep secrets server-only. No schedulers are created by setting these variables.
MAINTENANCE_SECRET=

# Web Push opt-in. Public key may reach the browser; private key stays server-only.
# Generate a separate key pair for each environment. No historical inbox backfill.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Release order, DB switches and required external acceptance:
# docs/PAYMENT-EMAIL-RELEASE.md
